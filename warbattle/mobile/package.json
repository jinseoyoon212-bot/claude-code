{
  "name": "warbattle-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android packaging for Warbattle (Capacitor)",
  "scripts": {
    "prepare-web": "node ../scripts/build-web.mjs",
    "sync": "npm run prepare-web && npx cap sync android",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0"
  }
}
